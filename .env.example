# Yojna Saathi - Environment Variables
# Copy to .env and fill in values

# Server
PORT=3000
NODE_ENV=development

# AI Service (optional - app works in demo mode without this)
AI_API_KEY=
AI_API_URL=

# OCR Service (optional - app works in demo mode without this)
OCR_API_KEY=
OCR_API_URL=

# Demo mode (set to true to use mock data/services)
DEMO_MODE=true
